---
interface Props {
  florist: any;
  rank?: number;
}

const { florist, rank } = Astro.props;
const checkDate = new Date().toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class={`florist-card ${florist.isRecommended ? 'recommended' : ''}`}>
  {florist.isRecommended && (
    <div class="badge">Aanbevolen Keuze</div>
  )}
  <div class="card-header">
    <div class="title-wrap">
      {rank && <span class="rank-number">#{rank}</span>}
      <h3 class="name">{florist.name}</h3>
    </div>
    
    <div class="score-wrap">
      <div class="g-score">
        <div class="main-score-row">
          <span class="stars">★★★★★</span>
          <strong>{florist.reviews.googleScore}</strong> 
        </div>
        <div class="review-counts">
          <small>{florist.reviews.googleCount + (florist.reviews.facebookCount || 0)} beoordelingen</small>
          <span class="review-breakdown">({florist.reviews.googleCount} Google / {florist.reviews.facebookCount || 0} Facebook)</span>
        </div>
      </div>
      <div class="total-score" title="Onze objectieve rating o.b.v. service & kwaliteit">
        Gids Score: <strong>{florist.scoreCalc.total}/100</strong>
      </div>
    </div>
  </div>

  <div class="card-body">
    <p class="description">{florist.description}</p>
    
    {florist.testimonial && (
      florist.testimonial.url ? (
        <a href={florist.testimonial.url} target="_blank" rel="noopener noreferrer" class="testimonial-box clickable" data-umami-event={`Review Click: ${florist.name}`}>
          <div class="stars">{'★'.repeat(florist.testimonial.rating)}</div>
          <blockquote>{florist.testimonial.text}</blockquote>
          <cite>- {florist.testimonial.author} <span class="external-icon">↗</span></cite>
        </a>
      ) : (
        <div class="testimonial-box">
          <div class="stars">{'★'.repeat(florist.testimonial.rating)}</div>
          <blockquote>{florist.testimonial.text}</blockquote>
          <cite>- {florist.testimonial.author}</cite>
        </div>
      )
    )}
    
    <div class="details">
      <h4>Sterke Punten:</h4>
      <ul>
        {florist.highlights.map((h: string) => (
          <li>✓ {h}</li>
        ))}
      </ul>
      
      <div class="location-contact">
        <p><strong>Adres:</strong> {florist.address.streetAddress}, {florist.address.addressLocality}</p>
        <p><strong>Tel:</strong> <a href={`tel:${florist.telephone.replace(/ /g, '')}`} data-umami-event={`Bellen: ${florist.name}`}>{florist.telephone}</a></p>
        {florist.email && <p><strong>E-mail:</strong> <a href={`mailto:${florist.email}`} data-umami-event={`Mailen: ${florist.name}`}>{florist.email}</a></p>}
        {(florist.googleMapsUrl || florist.appleMapsUrl || florist.facebookUrl || florist.instagramUrl) && (
          <div class="external-profiles">
            <span class="profiles-label"><strong>Profielen:</strong></span>
            <div class="profile-icons">
              {florist.googleMapsUrl && (
                <a href={florist.googleMapsUrl} target="_blank" rel="noopener noreferrer" title="Bekijk op Google" class="profile-link google-link" data-umami-event={`Google Maps: ${florist.name}`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                  </svg>
                </a>
              )}
              {florist.appleMapsUrl && (
                <a href={florist.appleMapsUrl} target="_blank" rel="noopener noreferrer" title="Bekijk op Apple Maps" class="profile-link apple-link" data-umami-event={`Apple Maps: ${florist.name}`}>
                  <svg width="16" height="16" viewBox="0 0 384 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
                  </svg>
                </a>
              )}
              {florist.facebookUrl && (
                <a href={florist.facebookUrl} target="_blank" rel="noopener noreferrer" title="Bekijk op Facebook" class="profile-link facebook-link" data-umami-event={`Facebook: ${florist.name}`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2C6.48 2 2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.9v-3H10V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-1.11 9-5.59 9-10.95 0-5.52-4.48-10-10-10z" fill="#0866FF"/>
                  </svg>
                </a>
              )}
              {florist.instagramUrl && (
                <a href={florist.instagramUrl} target="_blank" rel="noopener noreferrer" title="Bekijk op Instagram" class="profile-link instagram-link" data-umami-event={`Instagram: ${florist.name}`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="2" width="20" height="20" rx="4" fill="url(#ig-grad)"/>
                    <path d="M12 7A5 5 0 1 0 12 17A5 5 0 1 0 12 7ZM12 15A3 3 0 1 1 12 9A3 3 0 1 1 12 15Z" fill="#fff"/>
                    <circle cx="16.5" cy="7.5" r="1.5" fill="#fff"/>
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M7 2H17C19.7614 2 22 4.23858 22 7V17C22 19.7614 19.7614 22 17 22H7C4.23858 22 2 19.7614 2 17V7C2 4.23858 4.23858 2 7 2ZM7 4C5.34315 4 4 5.34315 4 7V17C4 18.6569 5.34315 20 7 20H17C18.6569 20 20 18.6569 20 17V7C20 5.34315 18.6569 4 17 4H7Z" fill="#fff"/>
                    <defs>
                      <linearGradient id="ig-grad" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#FD1D1D"/>
                        <stop offset="0.5" stop-color="#C13584"/>
                        <stop offset="1" stop-color="#405DE6"/>
                      </linearGradient>
                    </defs>
                  </svg>
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="card-footer">
    <p class="checked-date">Laatste check: {checkDate}</p>
    
    <div class="actions">
      <a href={florist.url} class={`btn ${florist.isRecommended ? 'btn-primary' : 'btn-outline'}`} target="_blank" rel="noopener noreferrer" data-umami-event={`Bekijk Website: ${florist.name}`}>
        {florist.isRecommended ? 'Bekijk & Bestel' : 'Bezoek Website'}
      </a>
    </div>
  </div>
</article>

<script>
  // Simple intersection observer to fade in cards on scroll
  if (typeof window !== 'undefined') {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.florist-card').forEach((el, index) => {
      // Add staggered delay based on index
      (el as HTMLElement).style.transitionDelay = `${index * 0.1}s`;
      observer.observe(el);
    });
  }
</script>

<style>
  .florist-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    opacity: 0;
    transform: translateY(20px);
  }

  .florist-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .florist-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .florist-card.recommended {
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 20px rgba(232, 108, 96, 0.1);
  }

  .badge {
    position: absolute;
    top: -15px;
    right: 20px;
    background: var(--color-accent);
    color: white;
    padding: 4px 16px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .rank-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-light);
  }

  .name {
    margin: 0;
  }

  .score-wrap {
    text-align: right;
  }

  .stars {
    color: #fbbc04; /* Google Star Color */
    font-size: 1.25rem;
  }

  .g-score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .main-score-row {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 2px;
  }

  .g-score strong {
    font-size: 1.25rem;
  }
  
  .review-counts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .review-breakdown {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    opacity: 0.7;
    margin-top: 2px;
  }

  .total-score {
    font-size: 0.875rem;
    color: var(--color-primary);
    background: var(--color-primary-light);
    color: white;
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    margin-top: 4px;
  }

  .card-body {
    flex-grow: 1;
  }

  .description {
    font-size: 1.125rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .details h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .testimonial-box {
    background: var(--color-bg);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-md) var(--space-lg);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: var(--space-lg);
    position: relative;
    display: block;
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  
  .testimonial-box.clickable:hover {
    background: #f5f9f6; /* Subtle hover state */
    transform: translateX(4px);
  }
  
  .testimonial-box .stars {
    color: #fbbc04;
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .testimonial-box blockquote {
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 var(--space-xs) 0;
    line-height: 1.5;
  }

  .testimonial-box cite {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    font-style: normal;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  
  .external-icon {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .details ul {
    list-style: none;
    margin-bottom: var(--space-lg);
  }

  .details li {
    position: relative;
    padding: 2px 0;
    color: var(--color-text-muted);
  }

  .location-contact {
    background: var(--color-bg);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .location-contact p {
    margin: 0;
  }
  
  .external-profiles {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }
  
  .profile-icons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    color: var(--color-text);
    background-color: rgba(0,0,0,0.05);
    opacity: 0.7;
    transition: all var(--transition-fast);
  }
  
  .profile-link:hover {
    opacity: 1;
    background-color: rgba(0,0,0,0.08); /* slight darkening of bg */
    transform: translateY(-1px);
  }
  
  .google-link:hover {
    background-color: #DB4437;
  }
  
  .apple-link:hover {
    background-color: #000000;
  }

  .facebook-link:hover {
    background-color: #e4e6eb;
  }

  .instagram-link:hover {
    background-color: #000000;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .checked-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
    }
    .score-wrap {
      text-align: left;
    }
    .card-footer {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
