---
import type { Florist } from '../lib/florists';
import { formatDate, formatRating, utm } from '../lib/florists';

interface Props {
  florist: Florist;
  rank: number;
}

const { florist, rank } = Astro.props;

const pillars = [
  { label: 'Publieke waardering', value: florist.score.waardering, max: 40 },
  { label: 'Service & gemak', value: florist.score.serviceGemak, max: 20 },
  { label: 'Direct bestellen & transparantie', value: florist.score.directTransparant, max: 20 },
  { label: 'Aanbod & specialisme', value: florist.score.aanbodSpecialisme, max: 20 },
];

const openDays = florist.openingHours.filter((slot) => !slot.closed);
const closedDays = florist.openingHours.filter((slot) => slot.closed).map((slot) => slot.day);

// Sterren volgen de werkelijke score in plaats van altijd vijf te tonen.
const fullStars = Math.floor(florist.reviews.googleScore);
const hasHalfStar = florist.reviews.googleScore - fullStars >= 0.25;
---

<article class={`florist-card ${florist.isRecommended ? 'recommended' : ''}`} id={florist.slug}>
  {florist.isRecommended && <p class="badge">Hoogste score</p>}
  {florist.isNew && !florist.isRecommended && <p class="badge badge-new">Nieuw in de gids</p>}

  <div class="card-header">
    <div class="title-wrap">
      <span class="rank-number" aria-hidden="true">#{rank}</span>
      <h3 class="name"><span class="sr-only">Plaats {rank}: </span>{florist.name}</h3>
    </div>

    <div class="score-wrap">
      <p class="g-score">
        <span class="stars" aria-hidden="true"
          >{'★'.repeat(fullStars)}{hasHalfStar ? '½' : ''}</span
        >
        <strong>{formatRating(florist.reviews.googleScore)}</strong>
        <span class="review-count">uit {florist.reviews.googleCount} Google-beoordelingen</span>
      </p>
      {florist.dataInsufficient && (
        <p class="data-insufficient">
          ⚠ Weinig beoordelingen — nog geen stabiel beeld
        </p>
      )}
      <p class="total-score">
        Gids Score <strong>{florist.score.total}</strong><span aria-hidden="true">/100</span>
        <span class="sr-only">van 100</span>
      </p>
    </div>
  </div>

  <div class="card-body">
    <p class="description">{florist.description}</p>

    {florist.testimonial && (
      <figure class="testimonial-box">
        <blockquote cite={florist.testimonial.url}>{florist.testimonial.text}</blockquote>
        <figcaption>
          {florist.testimonial.author} ·{' '}
          {florist.testimonial.url ? (
            <a
              href={florist.testimonial.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-umami-event={`Review Click: ${florist.name}`}
            >
              {florist.testimonial.source} <span class="external-icon" aria-hidden="true">↗</span>
            </a>
          ) : (
            florist.testimonial.source
          )}
        </figcaption>
      </figure>
    )}

    <div class="details">
      <h4>Sterke punten</h4>
      <ul class="highlights">
        {florist.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>

      <p class="ordering">
        <strong>Bestellen:</strong> {florist.ordering.note}
      </p>

      <dl class="location-contact">
        <dt>Adres</dt>
        <dd>
          {florist.address.streetAddress}, {florist.address.postalCode}{' '}
          {florist.address.addressLocality}
        </dd>

        <dt>Telefoon</dt>
        <dd>
          <a
            href={`tel:+31${florist.telephone.replace(/\D/g, '').replace(/^0/, '')}`}
            data-umami-event={`Bellen: ${florist.name}`}>{florist.telephone}</a>
        </dd>

        {florist.email && (
          <>
            <dt>E-mail</dt>
            <dd>
              <a href={`mailto:${florist.email}`} data-umami-event={`Mailen: ${florist.name}`}
                >{florist.email}</a>
            </dd>
          </>
        )}

        {openDays.length > 0 && (
          <>
            <dt>Openingstijden</dt>
            <dd>
              <ul class="hours">
                {openDays.map((slot) => (
                  <li>
                    <span>{slot.day}</span>
                    <span>{slot.opens} – {slot.closes}</span>
                  </li>
                ))}
                {closedDays.length > 0 && (
                  <li class="closed">
                    <span>{closedDays.join(', ')}</span>
                    <span>gesloten</span>
                  </li>
                )}
              </ul>
            </dd>
          </>
        )}
      </dl>

      <div class="external-profiles">
        <span class="profiles-label">Profielen:</span>
        <span class="profile-links">
          {florist.googleMapsUrl && (
            <a
              href={florist.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-umami-event={`Google Maps: ${florist.name}`}>Google</a>
          )}
          {florist.appleMapsUrl && (
            <a
              href={florist.appleMapsUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-umami-event={`Apple Maps: ${florist.name}`}>Apple Maps</a>
          )}
          {florist.facebookUrl && (
            <a
              href={florist.facebookUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-umami-event={`Facebook: ${florist.name}`}>Facebook</a>
          )}
          {florist.instagramUrl && (
            <a
              href={florist.instagramUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-umami-event={`Instagram: ${florist.name}`}>Instagram</a>
          )}
        </span>
      </div>

      <details class="score-breakdown">
        <summary>Hoe komt deze score van {florist.score.total} tot stand?</summary>
        <table>
          <caption>
            Puntentelling volgens <a href="/methode/">onze methode</a>. Het reviewgemiddelde is
            gecorrigeerd voor het aantal beoordelingen: {florist.score.adjustedRating
              .toString()
              .replace('.', ',')} na correctie.
          </caption>
          <tbody>
            {pillars.map((pillar) => (
              <tr>
                <th scope="row">{pillar.label}</th>
                <td>{pillar.value.toString().replace('.', ',')} / {pillar.max}</td>
              </tr>
            ))}
            <tr class="total-row">
              <th scope="row">Totaal</th>
              <td>{florist.score.total} / 100</td>
            </tr>
          </tbody>
        </table>
        <ul class="basis-list">
          {Object.values(florist.scoring).map((item) => (
            <li>{item.basis}</li>
          ))}
        </ul>
      </details>
    </div>
  </div>

  <div class="card-footer">
    <p class="checked-date">
      Gegevens gecontroleerd op{' '}
      <time datetime={florist.lastChecked}>{formatDate(florist.lastChecked)}</time>
    </p>

    <p class="actions">
      <a
        href={utm(florist.url, `kaart-${florist.slug}`)}
        class={`btn ${florist.isRecommended ? 'btn-primary' : 'btn-outline'}`}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event={`Bekijk Website: ${florist.name}`}
      >
        Website van {florist.name}
      </a>
    </p>
  </div>
</article>

<style>
  .florist-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    position: relative;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    scroll-margin-top: 6rem;
  }

  .florist-card.recommended {
    border: 2px solid var(--color-accent);
  }

  .badge {
    position: absolute;
    top: -14px;
    right: 20px;
    background: var(--color-accent);
    color: white;
    padding: 4px 16px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 700;
    margin: 0;
  }

  .badge-new {
    background: var(--color-primary-light);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .rank-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-light);
  }

  .name {
    margin: 0;
  }

  .score-wrap {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .g-score {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.3;
  }

  .stars {
    color: #b8860b;
    font-size: 1.125rem;
    letter-spacing: 1px;
  }

  .g-score strong {
    font-size: 1.25rem;
  }

  .review-count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .data-insufficient {
    font-size: 0.7rem;
    color: #7c4a02;
    background: #fef3c7;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    margin: 0;
  }

  .total-score {
    font-size: 0.875rem;
    background: var(--color-primary);
    color: white;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    margin: 0;
  }

  .card-body {
    flex-grow: 1;
  }

  .description {
    font-size: 1.0625rem;
    margin-bottom: var(--space-md);
  }

  .details h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }

  .testimonial-box {
    background: var(--color-bg);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-md) var(--space-lg);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 0 0 var(--space-lg);
  }

  .testimonial-box blockquote {
    font-style: italic;
    margin: 0 0 var(--space-xs);
    line-height: 1.5;
  }

  .testimonial-box figcaption {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .external-icon {
    font-size: 0.75rem;
  }

  .highlights {
    list-style: none;
    margin-bottom: var(--space-md);
    padding: 0;
  }

  .highlights li {
    padding: 2px 0 2px 1.4em;
    position: relative;
    color: var(--color-text-muted);
  }

  .highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-light);
    font-weight: 700;
  }

  .ordering {
    font-size: 0.9375rem;
    background: #f3f7f4;
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
  }

  .location-contact {
    background: var(--color-bg);
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 6px var(--space-md);
    margin: 0;
  }

  .location-contact dt {
    font-weight: 700;
  }

  .location-contact dd {
    margin: 0;
  }

  .hours {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    max-width: 18rem;
  }

  .hours .closed {
    color: var(--color-text-muted);
  }

  .external-profiles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    font-size: 0.875rem;
  }

  .profiles-label {
    font-weight: 700;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .score-breakdown {
    margin-top: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
  }

  .score-breakdown summary {
    cursor: pointer;
    font-weight: 600;
  }

  .score-breakdown table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-sm);
  }

  .score-breakdown caption {
    caption-side: bottom;
    text-align: left;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    padding-top: var(--space-sm);
  }

  .score-breakdown th {
    text-align: left;
    font-weight: 500;
    padding: 3px 0;
  }

  .score-breakdown td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .total-row th,
  .total-row td {
    border-top: 1px solid var(--color-border);
    font-weight: 700;
    padding-top: var(--space-xs);
  }

  .basis-list {
    margin: var(--space-md) 0 0;
    padding-left: var(--space-lg);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .basis-list li {
    margin-bottom: var(--space-xs);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .checked-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .actions {
    margin: 0;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
    }

    .score-wrap {
      text-align: left;
      align-items: flex-start;
    }

    .location-contact {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .location-contact dt {
      margin-top: var(--space-sm);
    }

    .card-footer {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
