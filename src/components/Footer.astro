---
import { florists, meta, topFlorist, formatDate, utm } from '../lib/florists';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col">
      <h2>Bloemen Gorinchem Gids</h2>
      <p>
        Alle {florists.length} vakbloemisten met een eigen winkel in Gorinchem, vergeleken volgens
        een vaste puntentelling die vooraf is gepubliceerd.
      </p>
      <p class="checked">
        Laatste datacontrole:{' '}
        <time datetime={meta.lastReviewUpdate}>{formatDate(meta.lastReviewUpdate)}</time>
      </p>
    </div>

    <nav class="footer-col" aria-label="Voettekstmenu">
      <h2>Op deze site</h2>
      <ul>
        <li><a href="/bloemist-gorinchem/">Alle bloemisten vergelijken</a></li>
        <li><a href="/bloemenwinkels-gorinchem/">Adressen en openingstijden</a></li>
        <li><a href="/bloemen-bezorgen-gorinchem/">Bezorgen en afhalen</a></li>
        <li><a href="/rouwboeket-gorinchem/">Rouwwerk</a></li>
        <li><a href="/trouwboeket-gorinchem/">Bruidswerk</a></li>
        <li><a href="/keuzehulp/">Keuzehulp</a></li>
      </ul>
    </nav>

    <div class="footer-col">
      <h2>Hoogste score nu</h2>
      <p>
        <strong>{topFlorist.name}</strong> staat met {topFlorist.score.total} van 100 punten
        bovenaan. <a href="/methode/">Zo tellen wij de punten.</a>
      </p>
      <a
        href={utm(topFlorist.url, 'footer')}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary footer-btn"
        data-umami-event={`Footer CTA: ${topFlorist.name}`}
      >
        Naar {topFlorist.name}
      </a>
    </div>
  </div>

  <div class="footer-bottom container">
    <p>
      © {new Date().getFullYear()} Bloemen-Gorinchem.nl ·
      <a href="/over/">Over deze gids</a> ·
      <a href="/methode/">Methode</a> ·
      <a href="mailto:info@bloemen-gorinchem.nl">info@bloemen-gorinchem.nl</a>
    </p>
    <p class="disclosure">
      Geen betaalde plaatsing: bloemisten kunnen geen positie of vermelding kopen. Gegevens komen
      van openbare bronnen en kunnen tussen twee controles door veranderen — controleer prijzen en
      openingstijden bij de bloemist zelf.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: var(--color-surface);
    padding: var(--space-3xl) 0 var(--space-xl);
    margin-top: var(--space-3xl);
  }

  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-col h2 {
    color: var(--color-surface);
    font-size: 1.125rem;
    font-family: var(--font-sans);
    margin-bottom: var(--space-md);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col ul li {
    margin-bottom: var(--space-xs);
  }

  .footer-col a:not(.btn) {
    color: var(--color-border);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-col a:not(.btn):hover {
    color: white;
  }

  .checked {
    font-size: 0.8125rem;
    opacity: 0.75;
    margin-top: var(--space-sm);
  }

  .footer-btn {
    margin-top: var(--space-md);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-md);
    font-size: 0.875rem;
    color: var(--color-border);
    text-align: center;
  }

  .footer-bottom a {
    color: var(--color-border);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-bottom a:hover {
    color: white;
  }

  .disclosure {
    margin-top: var(--space-sm);
    font-size: 0.8125rem;
    opacity: 0.8;
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }
</style>
