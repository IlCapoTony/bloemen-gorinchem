---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloristCard from '../components/FloristCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { florists, meta, topFlorist, formatDate, formatMonth, formatRating, utm } from '../lib/florists';
import { faqSchema, floristSchema, rankingSchema } from '../lib/schema';
import { seizoenVoor } from '../data/seizoen';

const pageTitle = `Bloemist Gorinchem: de ${florists.length} winkels vergeleken`;
const pageDescription = `Welke bloemist in Gorinchem kunt u het beste kiezen? Wij vergeleken de ${florists.length} vakbloemisten met een eigen winkel op reviews, bestelgemak, rouw- en bruidswerk. Bijgewerkt ${formatMonth(meta.lastReviewUpdate)}.`;

const runnerUp = florists[1];
const pageUrl = 'https://www.bloemen-gorinchem.nl/';
const seizoen = seizoenVoor(meta.lastReviewUpdate);

const faqs = [
  {
    question: 'Welke bloemist in Gorinchem wordt het best beoordeeld?',
    answer: `${topFlorist.name} aan de ${topFlorist.address.streetAddress} heeft de hoogste publieke waardering van Gorinchem: een ${formatRating(topFlorist.reviews.googleScore)} gemiddeld uit ${topFlorist.reviews.googleCount} Google-beoordelingen, ruim vier keer zoveel beoordelingen als de nummer twee. ${runnerUp.name} komt op hetzelfde gemiddelde uit, maar over ${runnerUp.reviews.googleCount} beoordelingen.`,
  },
  {
    question: 'Waar kan ik in Gorinchem online bloemen bestellen en betalen?',
    answer:
      'Annet Flowers (De Linie 28) en Mooi Bloemen en Planten (Piazza Center 57) hebben allebei een volledige eigen webshop waar u direct afrekent en kunt laten bezorgen. Loeff Bloemen (Coupure 2) verkoopt online één boeket op maat, dat u minimaal twee werkdagen vooraf bestelt en in de winkel afhaalt; ander bloemwerk bestelt u daar telefonisch of aan de balie. Mimosa Bloemen neemt bestellingen telefonisch of in de winkel op. Bestellen bij de bloemist zelf betekent dat er geen landelijke tussenpartij een deel van het bedrag inhoudt.',
  },
  {
    question: 'Hoe lang van tevoren moet ik bloemen bestellen in Gorinchem?',
    answer:
      'Voor een gewoon boeket is dezelfde dag meestal genoeg: Mooi Bloemen en Planten bezorgt bij bestellen vóór 12:00 uur nog dezelfde dag in Gorinchem en Sliedrecht, Annet Flowers hanteert 14:00 uur. Voor rouwwerk en bruidswerk is maatwerk nodig; reken daarvoor op minimaal één tot twee dagen, en bij bruidswerk op een afspraak vooraf.',
  },
  {
    question: `Welke bloemen zijn in ${seizoen.maand} in het seizoen?`,
    answer: `In ${seizoen.maand} komen ${seizoen.bloemen} uit Nederlandse teelt. Seizoensbloemen hoeven niet ingevlogen te worden, zijn daardoor doorgaans goedkoper en staan gemiddeld langer op de vaas dan bloemen buiten hun seizoen. ${seizoen.tip}`,
  },
  {
    question: 'Welke bloemisten staan wel en niet in deze gids?',
    answer: `Deze gids gaat alleen over vakbloemisten met een eigen winkel binnen de gemeente Gorinchem, op dit moment ${florists.length} winkels. Landelijke bestelplatforms met een pagina over Gorinchem, zoals Bloemenhuis Hofman en Regiobloemist.nl, staan er bewust niet in: die hebben hier geen winkel en zetten uw bestelling door naar een aangesloten bloemist.`,
  },
];

const schema = [
  rankingSchema(florists, pageUrl),
  ...florists.map((florist, index) => floristSchema(florist, index + 1)),
  faqSchema(faqs, pageUrl),
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <Header />

  <main id="hoofdinhoud">
    <section class="hero-section">
      <div class="container container-narrow">
        <p class="eyebrow">Lokale vergelijkingsgids · bijgewerkt {formatMonth(meta.lastReviewUpdate)}</p>
        <h1>Welke bloemist in Gorinchem kunt u het beste kiezen?</h1>

        <div class="answer-box">
          <p class="answer-lead">
            <strong>{topFlorist.name}</strong> ({topFlorist.address.streetAddress}) staat op nummer 1
            met een Gids Score van {topFlorist.score.total} van 100, vooral door het grootste
            reviewvolume van de stad: {topFlorist.reviews.googleCount} Google-beoordelingen met een
            {' '}{formatRating(topFlorist.reviews.googleScore)} gemiddeld. Bestellen
            gaat er telefonisch, in de winkel of online voor een boeket op maat om af te halen. Wilt u
            online bestellen en laten bezorgen, dan kan dat bij
            <strong> {runnerUp.name}</strong> ({runnerUp.score.total}/100); de webshop van
            {' '}{topFlorist.name} is alleen voor afhalen.
          </p>
          <p class="answer-meta">
            Cijfers bijgewerkt op <time datetime={meta.lastReviewUpdate}>{formatDate(meta.lastReviewUpdate)}</time>
            · {florists.length} winkels vergeleken · <a href="/methode/">zo tellen wij de punten</a>
          </p>
          <p class="answer-actions">
            <a
              href={utm(topFlorist.url, 'homepage-antwoordblok')}
              class="btn btn-primary cta-btn"
              target="_blank"
              rel="noopener noreferrer"
              data-umami-event={`Hero CTA: ${topFlorist.name}`}
            >
              Naar {topFlorist.name}
            </a>
            <a href="/bloemist-gorinchem/" class="btn btn-outline">Bekijk de volledige vergelijking</a>
          </p>
        </div>
      </div>
    </section>

    <section class="table-section bg-light">
      <div class="container">
        <h2>Bloemisten in Gorinchem vergeleken</h2>
        <ComparisonTable
          florists={florists}
          caption={`De ${florists.length} vakbloemisten met een eigen winkel in Gorinchem die aan onze opnamecriteria voldoen, gerangschikt op Gids Score. Google-cijfers afkomstig van de bedrijfsprofielen op ${formatDate(meta.lastReviewUpdate)}.`}
        />
      </div>
    </section>

    <section class="florists-section container">
      <div class="section-header">
        <h2>De bloemisten één voor één</h2>
        <p>
          Elke kaart laat zien waar de punten vandaan komen, welke gegevens we hebben gecontroleerd
          en wanneer dat voor het laatst gebeurde.
        </p>
      </div>

      <div class="florist-grid">
        {florists.map((florist, index) => (
          <FloristCard florist={florist} rank={index + 1} />
        ))}
      </div>

      <p class="text-center mt-xl">
        <a href="/methode/" class="btn btn-outline">Lees hoe wij de Gids Score berekenen</a>
      </p>
    </section>

    <section class="season-section bg-light">
      <div class="container container-narrow">
        <h2>Bloemen kopen in {seizoen.maand}</h2>
        <p>{seizoen.toelichting}</p>
        <p>
          Seizoensbloemen zijn niet alleen goedkoper dan bloemen die buiten hun seizoen ingevlogen
          moeten worden, ze staan gemiddeld ook langer op de vaas.
        </p>
        <p><strong>Praktisch voor deze maand.</strong> {seizoen.tip}</p>
      </div>
    </section>

    <section class="faq-section container container-narrow">
      <h2>Veelgestelde vragen over bloemisten in Gorinchem</h2>
      <div class="faqs">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question"><h3>{faq.question}</h3></summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-3xl) 0;
    background: linear-gradient(to bottom, var(--color-bg), var(--color-surface));
  }

  .eyebrow {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .hero-section h1 {
    font-size: 2.75rem;
    margin-bottom: var(--space-2xl);
  }

  .answer-box {
    background: white;
    border: 2px solid var(--color-primary-light);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-lg);
    position: relative;
  }

  .answer-lead {
    font-size: 1.1875rem;
    margin-bottom: var(--space-md);
  }

  .answer-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .answer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
  }

  .cta-btn {
    font-size: 1.0625rem;
  }

  .bg-light {
    background-color: var(--color-bg);
  }

  .table-section {
    padding: var(--space-3xl) 0;
  }

  .table-section h2 {
    margin-bottom: var(--space-lg);
  }

  .florists-section {
    padding: var(--space-3xl) 0;
  }

  .section-header {
    margin-bottom: var(--space-2xl);
    max-width: var(--container-narrow);
  }

  .florist-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .season-section {
    padding: var(--space-3xl) 0;
  }

  .season-section p {
    margin-bottom: var(--space-md);
  }

  .faq-section {
    padding: var(--space-3xl) 0;
  }

  .faq-item {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
    overflow: hidden;
  }

  .faq-question {
    padding: var(--space-lg);
    cursor: pointer;
    background: var(--color-bg);
    transition: background var(--transition-fast);
  }

  .faq-question h3 {
    display: inline;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    margin: 0;
  }

  .faq-question:hover {
    background: var(--color-border);
  }

  .faq-answer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .mt-xl {
    margin-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 2rem;
    }

    .answer-box {
      padding: var(--space-xl);
    }

    .answer-actions .btn {
      width: 100%;
    }
  }
</style>
