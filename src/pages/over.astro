---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { florists, meta, formatDate } from '../lib/florists';

const pageTitle = 'Over deze gids';
const pageDescription =
  'Wie maakt de Bloemen Gorinchem Gids, waarom bestaat hij, hoe wordt hij betaald en hoe geeft u een correctie door?';

const breadcrumbs = [{ name: 'Over deze gids', href: '/over/' }];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <Header />
  <Breadcrumbs items={breadcrumbs} />

  <main id="hoofdinhoud">
    <section class="page-header bg-light">
      <div class="container container-narrow">
        <h1>Over deze gids</h1>
        <p class="lead">
          Wie dit maakt, waarom, en waar u ons op kunt aanspreken.
        </p>
      </div>
    </section>

    <section class="content-section container container-narrow">
      <article class="prose">
        <h2>Waarom deze gids bestaat</h2>
        <p>
          Wie in Gorinchem online naar een bloemist zoekt, komt vooral landelijke bestelplatforms
          tegen. Die hebben hier geen winkel: u bestelt bij het platform, en het platform zet de
          opdracht door naar een aangesloten bloemist. Er gaat dus een deel van uw geld naar
          bemiddeling en bezorging in plaats van naar bloemen — bij Fleurop bijvoorbeeld staan de
          bezorgkosten apart op de rekening. Hoeveel er precies blijft hangen verschilt per platform
          en wordt nergens openbaar gemaakt, dus wij noemen daar geen percentage bij.
        </p>
        <p>
          Deze gids doet iets simpelers: de bloemisten die hier daadwerkelijk een winkel hebben op
          een rij zetten, met kloppende adressen, openingstijden en beoordelingen, zodat u zelf kunt
          kiezen en rechtstreeks bij de winkel bestelt.
        </p>

        <h2>Wie het maakt</h2>
        <p>
          De Bloemen Gorinchem Gids wordt gemaakt en onderhouden door één inwoner van Gorinchem, niet
          door een redactie of een uitgever. Er zit geen bedrijf achter en er wordt geen
          journalistieke onafhankelijkheid geclaimd — het is één persoon die de openbare gegevens
          van {florists.length} lokale bloemisten bijhoudt volgens een
          <a href="/methode/">vaste, vooraf gepubliceerde puntentelling</a>.
        </p>

        <div class="disclosure">
          <h3>Waar u ons op kunt afrekenen</h3>
          <ul>
            <li>
              <strong>Er is geen betaalde plaatsing.</strong> Bloemisten kunnen geen positie in de
              ranglijst kopen en geen vermelding kopen. Er staan geen advertenties op deze site.
            </li>
            <li>
              <strong>De criteria staan vooraf vast en gelden voor iedereen gelijk.</strong> Ze
              staan voluit op de <a href="/methode/">methodepagina</a>, inclusief de formule, zodat u
              elke score zelf kunt narekenen met de cijfers op de kaart.
            </li>
            <li>
              <strong>De links naar bloemisten bevatten een herkenningscode</strong> (utm-parameters)
              zodat wij kunnen zien hoeveel bezoekers doorklikken. Dat kost u niets en levert ons
              niets op; het is alleen een teller.
            </li>
            <li>
              <strong>Wat we niet weten, zeggen we niet.</strong> Waar gegevens ontbreken of te dun
              zijn — zoals een gemiddelde uit twee beoordelingen — staat dat er met zoveel woorden
              bij.
            </li>
          </ul>
        </div>

        <h2>Waar de gegevens vandaan komen</h2>
        <p>
          De beoordelingscijfers komen van de openbare Google-bedrijfsprofielen. Adressen,
          openingstijden, bestelmogelijkheden en specialismen halen we van de website van de
          bloemist zelf en vergelijken we met het Google-profiel. Alles is voor u net zo goed te
          controleren als voor ons: de bronnen staan bij elke bloemist vermeld. De laatste controle
          was op <time datetime={meta.lastReviewUpdate}>{formatDate(meta.lastReviewUpdate)}</time>.
        </p>

        <h2>Een correctie doorgeven</h2>
        <p>
          Bent u bloemist en klopt er iets niet aan uw openingstijden, uw aanbod of uw
          bestelmogelijkheden? Of ontbreekt uw winkel terwijl u wel een eigen zaak in Gorinchem
          heeft? Mail het door, dan passen we het aan zodra we het publiek kunnen controleren.
          Feitelijke fouten herstellen we direct, niet pas bij de volgende ronde.
        </p>
        <p class="contact">
          <strong>E-mail:</strong>
          <a href="mailto:info@bloemen-gorinchem.nl">info@bloemen-gorinchem.nl</a>
        </p>
      </article>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }

  .bg-light {
    background-color: var(--color-bg);
  }

  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .content-section {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .prose {
    font-size: 1.0625rem;
  }

  .prose h2 {
    margin-top: var(--space-2xl);
    padding-bottom: var(--space-sm);
  }

  .prose p {
    margin-bottom: var(--space-md);
  }

  .disclosure {
    background: var(--color-bg);
    border-left: 4px solid var(--color-primary);
    padding: var(--space-lg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: var(--space-xl) 0;
  }

  .disclosure h3 {
    margin-top: 0;
    font-family: var(--font-sans);
    font-size: 1.125rem;
  }

  .disclosure ul {
    margin: 0;
    padding-left: var(--space-lg);
  }

  .disclosure li {
    margin-bottom: var(--space-sm);
  }

  .contact {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }
</style>
