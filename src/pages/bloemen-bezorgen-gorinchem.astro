---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';

const pageTitle = "Bloemen Bezorgen Gorinchem | Lokaal & Zorgvuldig Afgeleverd";
const pageDescription = "Bloemen bezorgen of afhalen in Gorinchem? Ontdek de best beoordeelde opties voor verse boeketten in Haarwijk, Lingewijk, Gorinchem-Oost en Dalem.";

const faqs = [
  {
    question: "Hoe ver van tevoren moet ik mijn bloemen bestellen?",
    answer: "Voor de beste kwaliteit en zekerheid adviseren top-bloemisten zoals Loeff Bloemen om minimaal 1 tot 2 dagen van tevoren te bestellen. Zo garanderen zij de meest verse bloemen en de benodigde tijd voor het ambachtelijke bindwerk."
  },
  {
    question: "Wat zijn de bezorgkosten voor bloemen in Gorinchem?",
    answer: "Bezorgkosten wisselen per bloemist. Via landelijke netwerken betaalt u vaak meer (waaronder bemiddelingskosten). Door direct lokaal te bestellen via de site van de bloemist zelf, profiteert u vaak van lagere, regionale bezorgtarieven en gaat uw volledige bedrag naar de bloemen."
  },
  {
    question: "In welke wijken in Gorinchem worden bloemen bezorgd?",
    answer: "Lokale bloemisten bezorgen in de regel in heel Gorinchem, waaronder de Haarwijk, Lingewijk, Gorinchem-Oost, Stalkaarsen, Wijdschild, Gildenwijk, de vesting, en het aangrenzende dorp Dalem."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    <section class="page-header bg-light">
      <div class="container container-narrow text-center">
        <h1>Bloemen Bezorgen in Gorinchem</h1>
        <p class="lead">Lokaal vakmanschap, zorgvuldig bij u of uw geliefden aan de deur bezorgd.</p>
        <a href="/bloemist-gorinchem" class="btn btn-primary mt-sm">Vergelijk alle lokale bloemisten</a>
      </div>
    </section>

    <section class="content-section container mt-xl">
      <div class="split-content">
        <article class="prose">
          <h2>Waarom lokaal afhalen vaak een nóg betere keuze is</h2>
          <p>Wanneer je een geliefde wilt verrassen met een vers boeket, denk je al snel aan bezorgen. Echter, door direct lokaal uw bloemen in Gorinchem te bestellen en <strong>zelf af te halen</strong>, geniet je van drie cruciale voordelen:</p>
          <ul>
            <li><strong>Sneller en Flexibeler:</strong> Geen wachttijden of onzekerheid over bezorgmomenten. Als u online bestelt bij een lokaal icoon zoals Loeff Bloemen, staat uw bestelling razendsnel klaar aan de Coupure.</li>
            <li><strong>Zorgvuldige Overhandiging:</strong> U overhandigt het boeket zelf, wat het cadeau nóg persoonlijker maakt.</li>
            <li><strong>100% Optimale bloemwaarde:</strong> Bezorgdiensten en landelijke ketens rekenen forse marges en bezorgkosten. Bij zelf afhalen gaat uw volledige budget rechtstreeks de vaas in, oftewel: u krijgt zichtbaar de beste prijs-kwaliteit verhouding.</li>
          </ul>

          <h3>Toch liever bezorgen?</h3>
          <p>Mocht afhalen niet uitkomen, dan bieden de meeste bloemisten uiteraard nog steeds lokale bezorging aan in alle wijken (zoals de Haarwijk, Lingewijk, Gorinchem-Oost, Stalkaarsen, Wijdschild en de Gildenwijk) en in Dalem. Lokale partijen rekenen hierbij aanzienlijk eerlijkere tarieven dan landelijke dozenschuivers.</p>
        </article>
      </div>
    </section>

    <section class="faq-section bg-light mt-2xl">
      <div class="container container-narrow">
        <h2 class="text-center">Veelgestelde vragen over bezorgen</h2>
        <div class="faqs mt-xl">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FAQPageSchema faqs={faqs} />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }
  .bg-light {
    background-color: var(--color-bg);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .prose {
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .prose h2, .prose h3 {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-sm);
  }
  .prose ul {
    margin-bottom: var(--space-xl);
    padding-left: var(--space-lg);
  }
  .prose li {
    margin-bottom: var(--space-sm);
  }
  .faq-section {
    padding: var(--space-3xl) 0;
  }
  .faq-item {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
    overflow: hidden;
  }
  .faq-question {
    padding: var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    background: var(--color-bg);
  }
  .faq-answer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .mt-sm { margin-top: var(--space-sm); }
  .mt-xl { margin-top: var(--space-xl); }
  .mt-2xl { margin-top: var(--space-2xl); }
</style>
