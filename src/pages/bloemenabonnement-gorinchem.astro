---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

import { faqSchema } from '../lib/schema';

const pageUrl = 'https://www.bloemen-gorinchem.nl/bloemenabonnement-gorinchem/';

const pageTitle = "Bloemenabonnement Gorinchem | Elke week of maand verse bloemen";
const pageDescription = "Een bloemenabonnement in Gorinchem? Geen van de vier bloemisten biedt er online een aan, maar u kunt wel een vaste afspraak met de winkel maken. Zo werkt dat.";

const faqs = [
  {
    question: "Kan ik het bloemenabonnement pauzeren tijdens vakanties?",
    answer: "Dat spreekt u zelf af. Geen van de vier bloemisten in Gorinchem biedt op dit moment een kant-en-klaar abonnement op de website aan; u maakt de afspraak rechtstreeks met de winkel. Juist daardoor liggen frequentie, budget en het overslaan van een week niet vast in een contract."
  },
  {
    question: "Is een bloemenabonnement inclusief leenvaas?",
    answer: "Dat is geen vast gebruik in Gorinchem en staat bij geen van de vier bloemisten op de website vermeld. Vraag het na als u het belangrijk vindt — bij een afspraak op maat is het bespreekbaar."
  }
];

const breadcrumbs = [{"name":"Bloemenabonnement","href":"/bloemenabonnement-gorinchem/"}];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[faqSchema(faqs, pageUrl)]}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <Breadcrumbs items={breadcrumbs} />

  <main id="hoofdinhoud">
    <section class="page-header bg-light">
      <div class="container container-narrow text-center">
        <h1>Bloemenabonnementen in Gorinchem</h1>
        <p class="lead">Haal wekelijks, tweewekelijks of maandelijks het seizoen in huis.</p>
        <a href="/bloemist-gorinchem/" class="btn btn-primary mt-sm">Vind uw ideale bloemist</a>
      </div>
    </section>

    <section class="content-section container mt-xl">
      <article class="prose max-w-700 mx-auto">
        <h2>Een Huis Vol Kleur</h2>
        <p>Wilt u elke week of maand verse bloemen in huis, dan is dat in Gorinchem geen kwestie van een abonnement afsluiten op een website. Geen van de vier bloemisten in deze gids biedt zo’n abonnement online aan. Wat wél kan: een vaste afspraak maken met de winkel over frequentie, budget en bezorging of ophalen. In de praktijk is dat flexibeler dan een landelijk abonnement, omdat u het per keer kunt bijstellen.</p>

        <h3>Waarom Lokaal en Niet Landelijk?</h3>
        <ul>
          <li><strong>Minder Kilometers:</strong> Landelijke brievenbus- of pakketaanbieders verpakken bloemen droog en sturen ze via pakketdiensten rond. Bij een lokale bloemist haalt u ze vers gebonden op, of laat u ze bezorgen door een van de drie winkels in de gids die zelf bezorgen.</li>
          <li><strong>Persoonlijke Smaak:</strong> Vindt u bepaalde geuren of kleuren juist niet mooi? Geef het door bij het maken van de afspraak, dan houdt de binder daar rekening mee. In onze <a href="/bloemist-gorinchem/">vergelijking</a> ziet u welke winkel bezorgt en welke niet.</li>
          <li><strong>Leenvaas opties:</strong> Vraag bij het maken van de afspraak of er een passende vaas bij kan. Dat is geen standaard onderdeel in Gorinchem, maar wel iets wat u kunt bespreken.</li>
        </ul>
      </article>
    </section>

    <section class="faq-section bg-light mt-2xl">
      <div class="container container-narrow">
        <h2 class="text-center">Veelgestelde vragen</h2>
        <div class="faqs mt-xl">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }
  .bg-light {
    background-color: var(--color-bg);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .prose {
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .mx-auto { margin-right: auto; margin-left: auto; }
  .max-w-700 { max-width: 800px; }
  .prose h2, .prose h3 {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-sm);
  }
  .prose ul {
    margin-bottom: var(--space-xl);
    padding-left: var(--space-lg);
  }
  .prose li {
    margin-bottom: var(--space-sm);
  }
  .faq-section {
    padding: var(--space-3xl) 0;
  }
  .faq-item {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
    overflow: hidden;
  }
  .faq-question {
    padding: var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    background: var(--color-bg);
  }
  .faq-answer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .mt-sm { margin-top: var(--space-sm); }
  .mt-xl { margin-top: var(--space-xl); }
  .mt-2xl { margin-top: var(--space-2xl); }
</style>
