---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

import { faqSchema } from '../lib/schema';

const pageUrl = 'https://www.bloemen-gorinchem.nl/rouwboeket-gorinchem/';

const pageTitle = "Rouwboeket Gorinchem | Persoonlijk en Zorgvuldig Afscheid";
const pageDescription = "Zoekt u een rouwboeket of rouwstuk in regio Gorinchem? Vergelijk de specialisten voor een zorgvuldig, prachtig en passend afscheid.";

const faqs = [
  {
    question: "Welke bloemist is gespecialiseerd in rouwwerk in Gorinchem?",
    answer: "Alle vier de bloemisten in onze gids leveren rouwwerk. Loeff Bloemen heeft er het langst ervaring mee en rouwwerk komt terug in recente klantbeoordelingen; Annet Flowers en Mimosa Bloemen hebben er een eigen afdeling voor, Mooi Bloemen en Planten adviseert over afscheidsstukken. Rouwwerk is altijd maatwerk: bel of loop binnen, dan bespreekt u de wensen persoonlijk."
  },
  {
    question: "Aan welke locaties in Gorinchem bezorgen ze een rouwstuk?",
    answer: "Rouwwerk wordt door lokale bloemisten veelal direct en stipt afgeleverd bij uitvaartcentra, crematoria of kerken rondom Gorinchem, maar ook levering bij het privéadres van de nabestaanden is gebruikelijk."
  },
  {
    question: "Moet ik een lint toevoegen aan het rouwboeket?",
    answer: "Een lint is optioneel, hoewel een bedrukt lint vaak troost biedt of dient als mooie laatste groet. Bespreek dit bij het doorgeven van de opdracht; de tekst wordt dan bij de leverancier van het lint besteld, wat een dag extra kan kosten."
  }
];

const breadcrumbs = [{"name":"Rouwboeket Gorinchem","href":"/rouwboeket-gorinchem/"}];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[faqSchema(faqs, pageUrl)]}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <Breadcrumbs items={breadcrumbs} />

  <main id="hoofdinhoud">
    <section class="page-header bg-light">
      <div class="container container-narrow text-center">
        <h1>Passend Rouwwerk in Gorinchem</h1>
        <p class="lead">Met zorg en respect samengesteld voor een persoonlijk afscheid rondom Gorinchem.</p>
        <a href="/bloemist-gorinchem/" class="btn btn-primary mt-sm">Vergelijk alle uitvaart specialisten</a>
      </div>
    </section>

    <section class="content-section container mt-xl">
      <article class="prose max-w-700 mx-auto">
        <h2>Een Laatste Groet in Bloemen</h2>
        <p>Afscheid nemen van een dierbare vereist aandacht. Een rouwboeket of bloemstuk vertelt vaak wat woorden tekort komen. Daarom telt rouwwerk in onze puntentelling mee als apart onderdeel: het is een vak apart, en niet elke winkel doet het even vaak.</p>
        
        <p>Bloemisten die het ambacht van rouwbindwerk beheersen, bieden flexibiliteit. Ze luisteren naar uw specifieke wensen – zoals de lievelingsbloem of kleur van de overledene – en zorgen dat alles op het laatste moment klopt.</p>

        <h3>Ontzorgen in een Moeilijke Tijd</h3>
        <p>Rouwstukken zijn kwetsbaar en moeten op een vast tijdstip op de juiste plek staan — een uitvaartcentrum, begraafplaats, kerk of thuisadres. Een bloemist uit Gorinchem rijdt die route zelf en kan het tijdstip met u afstemmen; bij een landelijk platform gaat het stuk via een aangesloten bloemist die u niet kent en niet spreekt.</p>

        <h3>Rouwarrangementen en linten bestellen</h3>
        <p>Rouwwerk — van biedermeiers en hartvormige stukken tot kleine troostboeketten — regelt u in Gorinchem het snelst per telefoon of aan de balie. Ook een afscheidslint of kaartje spreekt u dan meteen door. Alleen Annet Flowers en Mooi Bloemen en Planten hebben een webshop waarin u zelf kunt afrekenen; de andere twee nemen de opdracht persoonlijk op.</p>
      </article>
    </section>

    <section class="faq-section bg-light mt-2xl">
      <div class="container container-narrow">
        <h2 class="text-center">Vragen rondom rouwboeketten</h2>
        <div class="faqs mt-xl">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }
  .bg-light {
    background-color: var(--color-bg);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .prose {
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .mx-auto { margin-right: auto; margin-left: auto; }
  .max-w-700 { max-width: 800px; }
  .prose h2, .prose h3 {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-sm);
  }
  .faq-section {
    padding: var(--space-3xl) 0;
  }
  .faq-item {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
    overflow: hidden;
  }
  .faq-question {
    padding: var(--space-lg);
    font-weight: 600;
    cursor: pointer;
    background: var(--color-bg);
  }
  .faq-answer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
  .mt-sm { margin-top: var(--space-sm); }
  .mt-xl { margin-top: var(--space-xl); }
  .mt-2xl { margin-top: var(--space-2xl); }
</style>
