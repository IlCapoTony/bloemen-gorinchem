---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = "Zakelijke Bloemen Gorinchem | Flexibel B2B Bestellen";
const pageDescription = "Zakelijke bloemen in Gorinchem: Annet Flowers heeft als enige een zakelijk portaal met inlog; bij de andere drie winkels maakt u zakelijke afspraken rechtstreeks.";

const breadcrumbs = [{"name":"Zakelijke bloemen","href":"/zakelijke-bloemen-gorinchem/"}];
---

<BaseLayout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <Header />
  <Breadcrumbs items={breadcrumbs} />

  <main id="hoofdinhoud">
    <section class="page-header bg-light">
      <div class="container container-narrow text-center">
        <h1>Zakelijke Bloemen Gorinchem</h1>
        <p class="lead">Verwelkom medewerkers en gasten met een levendig kantoor, of verras relaties in stijl.</p>
        <a href="/bloemist-gorinchem/" class="btn btn-primary mt-sm">Vergelijk zakelijke aanbieders</a>
      </div>
    </section>

    <section class="content-section container mt-xl">
      <article class="prose max-w-700 mx-auto">
        <h2>Een Groene en Professionele Uitstraling</h2>
        <p>Een entree, balie of vergaderzaal zonder groen kan sfeerloos aanvoelen. Lokaal geregelde zakelijke bloemarrangementen in Gorinchem zorgen voor een warme en professionele ontvangst van uw bezoek. </p>

        <h3>Zakelijk Gemak & Facturatie</h3>
        <p>Eén bloemist in Gorinchem heeft hier een aparte voorziening voor: Annet Flowers werkt met een eigen zakelijk portaal met inlog. Bij Loeff Bloemen, Mooi Bloemen en Planten en Mimosa Bloemen maakt u zakelijke afspraken rechtstreeks met de winkel. Wat in de praktijk speelt:</p>
        <ul>
          <li><strong>Bestellen op Rekening / Factuur:</strong> Bij Annet Flowers kunnen medewerkers via de zakelijke inlog zelf bestellingen plaatsen. Bij de andere winkels regelt u facturatie in overleg; vraag ernaar bij de eerste opdracht.</li>
          <li><strong>Boeketten voor Personeel:</strong> Een boeket ter felicitatie of bij beterschap, met kaartje, kan bij Annet Flowers en Mooi Bloemen en Planten dezelfde dag bezorgd worden als u op tijd bestelt — vóór 14:00 respectievelijk 12:00 uur.</li>
        </ul>

      </article>
      
      <div class="text-center call-to-action mt-2xl pb-2xl">
        <a href="/bloemist-gorinchem/" class="btn btn-outline">Check de Vergelijker</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }
  .bg-light {
    background-color: var(--color-bg);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .prose {
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .mx-auto { margin-right: auto; margin-left: auto; }
  .max-w-700 { max-width: 800px; }
  .prose h2, .prose h3 {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-sm);
  }
  .prose ul {
    margin-bottom: var(--space-xl);
    padding-left: var(--space-lg);
  }
  .prose li {
    margin-bottom: var(--space-sm);
  }
  .call-to-action {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .mt-sm { margin-top: var(--space-sm); }
  .mt-xl { margin-top: var(--space-xl); }
  .mt-2xl { margin-top: var(--space-2xl); }
  .pb-2xl { padding-bottom: var(--space-2xl); }
</style>
