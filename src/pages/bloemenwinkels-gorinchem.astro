---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import floristsData from '../data/florists.json';

const sortedFlorists = floristsData.sort((a, b) => b.scoreCalc.total - a.scoreCalc.total);

const pageTitle = "Bloemenwinkels Gorinchem | Bekijk het lokale aanbod";
const pageDescription = "Overzicht van bloemenwinkels en bloemisten in Gorinchem. Bekijk adressen, details en ontdek de best beoordeelde bloemenzaak.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    <section class="page-header bg-light">
      <div class="container container-narrow text-center">
        <h1>Bloemenwinkels in Gorinchem</h1>
        <p class="lead">Een overzicht van fysieke bloemenzaken in de regio Gorinchem met bijbehorende contactgegevens.</p>
      </div>
    </section>

    <section class="directory-section container mt-2xl">
      <p class="text-center mb-xl">Wilt u niet langs de winkel, maar snel lokaal bloemen laten bezorgen? Bekijk dan direct ons <a href="/bloemist-gorinchem">onafhankelijke beste-keuze overzicht</a>.</p>
      
      <div class="shop-grid">
        {sortedFlorists.map(florist => (
          <article class={`shop-card ${florist.isRecommended ? 'highlighted' : ''}`}>
            {florist.isRecommended && <span class="badge">Aanbevolen</span>}
            <h2>{florist.name}</h2>
            <div class="shop-details">
              <p><strong>Adres:</strong> <br/>{florist.address.streetAddress}<br/>{florist.address.postalCode} {florist.address.addressLocality}</p>
              <p><strong>Telefoon:</strong> {florist.telephone}</p>
              <p><strong>Google Score:</strong> {florist.reviews.googleScore} / 5.0</p>
            </div>
            <a href={florist.isRecommended ? `${florist.url}/?utm_source=gids-gorinchem&utm_medium=referral&utm_campaign=gids-directory` : florist.url} class="btn btn-outline shop-btn" target="_blank" rel={florist.isRecommended ? 'noopener noreferrer' : 'noopener noreferrer nofollow'} data-umami-event={`Directory: ${florist.name}`}>
              Bezoek Website
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) 0;
  }
  .bg-light {
    background-color: var(--color-bg);
  }
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .directory-section {
    padding-bottom: var(--space-3xl);
  }
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-xl);
  }
  .shop-card {
    background: white;
    border: 1px solid var(--color-border);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    position: relative;
    box-shadow: var(--shadow-sm);
  }
  .shop-card.highlighted {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }
  .badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--color-accent);
    color: white;
    padding: 2px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: bold;
  }
  .shop-card h2 {
    font-size: 1.5rem;
    font-family: var(--font-sans);
    margin-bottom: var(--space-md);
  }
  .shop-details p {
    margin-bottom: var(--space-xs);
    font-size: 0.95rem;
  }
  .shop-btn {
    width: 100%;
    margin-top: var(--space-md);
  }
  .mb-xl { margin-bottom: var(--space-xl); }
  .mt-2xl { margin-top: var(--space-2xl); }
</style>
